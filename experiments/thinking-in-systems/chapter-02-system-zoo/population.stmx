<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE" xmlns:simlin="https://simlin.com/XMILE/v1.0">
    <header>
        <name>population</name>
        <vendor>Simlin</vendor>
        <product version="0.1.0" lang="en">Simlin</product>
    </header>
    <sim_specs method="euler" time_units="year">
        <start>2007</start>
        <stop>2067</stop>
        <dt reciprocal="true">2</dt>
    </sim_specs>
    <model_units>
        <unit name="Years">
            <alias>yr</alias>
            <alias>year</alias>
        </unit>
    </model_units>
    <model>
        <variables>
            <stock name="population">
                <eqn>100</eqn>
                <units>individuals</units>
                <inflow>births</inflow>
                <outflow>deaths</outflow>
                <non_negative></non_negative>
            </stock>
            <flow name="births">
                <eqn>population*birth_rate</eqn>
                <units>individuals/year</units>
                <non_negative></non_negative>
            </flow>
            <flow name="deaths">
                <eqn>population*death_rate</eqn>
                <units>individuals/year</units>
                <non_negative></non_negative>
            </flow>
            <aux name="birth_rate">
                <eqn>21/1000</eqn>
                <doc>For 1000 people, 21 people are born.</doc>
                <units>1/year</units>
            </aux>
            <aux name="death_rate">
                <eqn>30/1000</eqn>
                <doc>For every 1000 people, 9 die.</doc>
                <units>1/year</units>
            </aux>
        </variables>
        <views>
            <view isee:show_pages="false" page_width="800" page_height="600" view_type="stock_flow">
                <stock name="population" x="514" y="102.08333333333333" label_side="bottom"></stock>
                <flow name="births" x="439.75" y="102" label_side="bottom">
                    <pts>
                        <pt x="387" y="102"></pt>
                        <pt x="491.5" y="102"></pt>
                    </pts>
                </flow>
                <flow name="deaths" x="577.8333333333334" y="101.5" label_side="bottom">
                    <pts>
                        <pt x="536.5" y="101.5"></pt>
                        <pt x="643" y="101.5"></pt>
                    </pts>
                </flow>
                <connector angle="87.29335611879708">
                    <from>population</from>
                    <to>deaths</to>
                </connector>
                <connector angle="85.27553138333155">
                    <from>population</from>
                    <to>births</to>
                </connector>
                <aux name="birth rate" x="377.03125" y="146.40625" label_side="bottom"></aux>
                <aux name="death rate" x="641.1666666666667" y="146" label_side="bottom"></aux>
                <connector angle="35.299297951184315">
                    <from>birth rate</from>
                    <to>births</to>
                </connector>
                <connector angle="144.90740048056153">
                    <from>death rate</from>
                    <to>deaths</to>
                </connector>
            </view>
        </views>
    </model>
</xmile>