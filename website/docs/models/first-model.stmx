<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE" xmlns:simlin="https://simlin.com/XMILE/v1.0">
    <header>
        <name>first-model</name>
        <vendor>Simlin</vendor>
        <product version="0.1.0" lang="en">Simlin</product>
    </header>
    <sim_specs method="euler" time_units="years">
        <start>2020</start>
        <stop>2120</stop>
        <dt>0.5</dt>
    </sim_specs>
    <model>
        <variables>
            <stock name="population">
                <eqn>1000</eqn>
                <inflow>births</inflow>
                <outflow>deaths</outflow>
            </stock>
            <flow name="deaths">
                <eqn>&quot;Population change rate&quot;</eqn>
            </flow>
            <flow name="births">
                <eqn>&quot;Population change rate&quot;</eqn>
            </flow>
            <aux name="population_change_rate">
                <eqn>Population * 0.02</eqn>
            </aux>
        </variables>
        <views>
            <view isee:show_pages="false" page_width="800" page_height="600" view_type="stock_flow">
                <stock name="Population" x="584.5" y="365.5" label_side="bottom"></stock>
                <flow name="Deaths" x="672.8" y="365.5" label_side="bottom">
                    <pts>
                        <pt x="607" y="365.5"></pt>
                        <pt x="761.5" y="365.5"></pt>
                    </pts>
                </flow>
                <flow name="Births" x="514.95" y="368.19999999999993" label_side="bottom">
                    <pts>
                        <pt x="468.20000000000005" y="368.19999999999993"></pt>
                        <pt x="562" y="368.19999999999993"></pt>
                    </pts>
                </flow>
                <aux name="Population change rate" x="583.8" y="305.20000000000005" label_side="right"></aux>
                <connector angle="167.49300343924403">
                    <from>Population change rate</from>
                    <to>Births</to>
                </connector>
                <connector angle="-6.4558778277130955">
                    <from>Population change rate</from>
                    <to>Deaths</to>
                </connector>
            </view>
        </views>
    </model>
</xmile>